# Copy these values into your deployment provider's environment settings.
# Do not commit real secrets or database credentials.

ENVIRONMENT=production

# Prefer DATABASE_URL in production. If not using DATABASE_URL, set all DB_* values.
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres

JWT_SECRET=change-this-to-a-long-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Firebase staff identity verification. Use Application Default Credentials or
# point to a mounted service-account file. Do not send Firebase UIDs as auth.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CHECK_REVOKED=true

# Comma-separated browser origins. Native mobile apps do not need CORS.
# Example: https://admin.yourdomain.com,https://staff.yourdomain.com
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Comma-separated hostnames accepted by the API. Use * only if your platform
# terminates host validation before the app.
ALLOWED_HOSTS=*

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Redis is required for scalable production realtime. Keep it explicitly false
# for local development when no Redis server is running; outbox rows remain
# pending until a transport is enabled.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=60
OUTBOX_RETENTION_DAYS=14

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
